{
  "manifest_version": 3,
  "name": "Model Injector Pro",
  "short_name": "Model Injector",
  "version": "1.3.0",
  "description": "Independent model selection, context tracking, and request diagnostics for supported pages on chatgpt.com.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": ["config.js", "content.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": ["libs/o200k_base.js"],
      "run_at": "document_idle",
      "world": "MAIN"
    }
  ]
}
