{
  "manifest_version": 3,
  "name": "ChatGPT Model Injector Pro",
  "version": "1.0.0",
  "description": "Adaptive model switching, live token context tracking, and local ChatGPT request parameter controls.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*"
  ],
  "action": {
    "default_title": "ChatGPT Model Injector Pro"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": ["config.js", "libs/o200k_base.js", "content.js"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ]
}
