{
  "manifest_version": 3,
  "name": "ChatGPT Model Injector Pro",
  "version": "1.0",
  "description": "Adaptive model switching, live token context tracking, and injected API model support for ChatGPT.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["storage"],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": ["config.js", "libs/o200k_base.js", "content.js"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ]
}
